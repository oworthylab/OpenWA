{
  "name": "@openwa/api",
  "version": "0.0.1",
  "description": "OpenWA REST API — Elysia on Cloudflare Workers",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir=dist",
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "lint": "biome check src test",
    "clean": "rm -rf dist .turbo .wrangler *.tsbuildinfo"
  },
  "dependencies": {
    "@openwa/db": "workspace:*",
    "@openwa/shared": "workspace:*",
    "@openwa/validators": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "elysia": "^1.2.0",
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.7.3",
    "wrangler": "^4"
  }
}
