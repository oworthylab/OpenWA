{
  "name": "@openwa/engine-worker",
  "version": "0.0.1",
  "description": "Cloudflare Worker that hosts WhatsAppSessionDO (from @openwa/engine)",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir=dist",
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'no tests yet'",
    "lint": "biome check src",
    "clean": "rm -rf dist .turbo .wrangler *.tsbuildinfo"
  },
  "dependencies": {
    "@openwa/db": "workspace:*",
    "@openwa/engine": "workspace:*",
    "@openwa/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.7.3",
    "wrangler": "^4"
  }
}
