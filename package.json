{
  "name": "openwa",
  "version": "0.2.0-alpha.0",
  "description": "OpenWA — Serverless WhatsApp API Platform on Cloudflare",
  "author": "Yudhi Armyndharis & OpenWA Contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "bridge": "cd apps/wa-bridge && bun run start",
    "bridge:dev": "cd apps/wa-bridge && bun run dev",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "lefthook": "^1.10.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "npm@10.9.0",
  "engines": {
    "bun": ">=1.3.0"
  }
}
