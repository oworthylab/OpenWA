{
  "name": "@openwa/shared",
  "version": "0.0.1",
  "description": "Shared types, enums, and constants for the OpenWA platform",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./events": "./src/events/index.ts",
    "./api": "./src/api/index.ts",
    "./errors": "./src/errors/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "lint": "biome check src",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
