{
  "name": "@openwa/validators",
  "version": "0.0.1",
  "description": "Valibot validation schemas for OpenWA API",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth.ts",
    "./billing": "./src/billing.ts",
    "./crm": "./src/crm.ts",
    "./labels": "./src/labels.ts",
    "./mart": "./src/mart.ts",
    "./plugins": "./src/plugins.ts",
    "./session": "./src/session.ts",
    "./settings": "./src/settings.ts",
    "./statuses": "./src/statuses.ts",
    "./message": "./src/message.ts",
    "./webhook": "./src/webhook.ts",
    "./contact": "./src/contact.ts",
    "./group": "./src/group.ts",
    "./error": "./src/error.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "lint": "biome check src",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "valibot": "^1.0.0",
    "@openwa/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
