{
  "name": "@openwa/db",
  "version": "0.0.1",
  "description": "Drizzle ORM schemas and migrations for OpenWA D1 databases (control plane + per-tenant)",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./control-plane": "./src/schema/control-plane.ts",
    "./tenant": "./src/schema/tenant.ts",
    "./helpers": "./src/helpers.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "lint": "biome check src",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "db:generate:cp": "drizzle-kit generate --config=./drizzle.control-plane.config.ts",
    "db:generate:tenant": "drizzle-kit generate --config=./drizzle.tenant.config.ts",
    "db:migrate:local:cp": "wrangler d1 migrations apply openwa-control-plane --local",
    "db:migrate:local:tenant": "wrangler d1 migrations apply openwa-tenant-template --local",
    "db:studio:cp": "drizzle-kit studio --config=./drizzle.control-plane.config.ts"
  },
  "dependencies": {
    "@openwa/shared": "workspace:*",
    "drizzle-orm": "^0.36.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.7.3",
    "wrangler": "^4"
  }
}
