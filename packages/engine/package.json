{
  "name": "@openwa/engine",
  "version": "0.0.1",
  "description": "Adapter-driven WhatsApp engine for Node.js and Cloudflare Workers (Durable Objects)",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/adapters/node/index.ts",
    "./cloudflare": "./src/adapters/cloudflare/index.ts",
    "./state": "./src/state/index.ts",
    "./errors": "./src/errors/index.ts",
    "./events": "./src/events/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "lint": "biome check src",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@openwa/shared": "workspace:*",
    "@whiskeysockets/baileys": "^6.7.18",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.7.3"
  }
}
